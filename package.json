{
  "name": "daymark",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2"
  },
  "scripts": {
    "dev": "node init && pnpm --parallel --filter @daymark/web --filter @daymark/api dev",
    "build": "node init && pnpm --filter @daymark/api build && pnpm --filter @daymark/web build",
    "typecheck": "pnpm --filter @daymark/api typecheck && pnpm --filter @daymark/web typecheck",
    "db:generate": "pnpm --filter @daymark/api db:generate",
    "db:migrate": "pnpm --filter @daymark/api db:migrate",
    "db:deploy": "pnpm --filter @daymark/api db:deploy"
  }
}
