# Daymark shared environment
# Copy this file to .env at the repository root for local development.

# PostgreSQL runtime connection. Neon pooled connection URLs work well here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional direct PostgreSQL connection for Prisma migrations.
# Leave blank to reuse DATABASE_URL.
DIRECT_URL=

# NestJS API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000,http://localhost:3001
SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters

# Next.js web
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
